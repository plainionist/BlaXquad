<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ReqnrollDeleteObsoleteCodeBehindFilesOnClean>true</ReqnrollDeleteObsoleteCodeBehindFilesOnClean>
    <ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
    <SquadProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\squad\squad.csproj'))</SquadProject>
    <squadHQProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\squad-hq\squad-hq.csproj'))</squadHQProject>
    <CopilotProviderProjectDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\squad.AgentProvider.CopilotSdk'))</CopilotProviderProjectDirectory>
    <HostingStdioProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\squad.Hosting.Stdio\squad.Hosting.Stdio.csproj'))</HostingStdioProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.4" />
    <PackageReference Include="nunit" Version="4.5.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Reqnroll" />
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\squad\squad.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\squad-hq\squad-hq.csproj"
                      ReferenceOutputAssembly="false"
                      AdditionalProperties="IncludeCopilotSdkProvider=false;IncludePhotinoHosting=false" />
    <ProjectReference Include="..\squad.Domain\squad.Domain.csproj" />
    <ProjectReference Include="..\squad.AgentProvider.Abstractions\squad.AgentProvider.Abstractions.csproj" />
    <ProjectReference Include="..\squad.AgentProvider.Fake\squad.AgentProvider.Fake.csproj" />
    <ProjectReference Include="..\squad.Hosting.Abstractions\squad.Hosting.Abstractions.csproj" />
    <ProjectReference Include="..\squad.Hosting.Stdio\squad.Hosting.Stdio.csproj" />
    <ProjectReference Include="..\squad.Hosting.Fake\squad.Hosting.Fake.csproj" />
  </ItemGroup>

  <Target Name="PublishSquadTools">
    <PropertyGroup>
      <SquadToolsDir>$([System.IO.Path]::Combine('$(TargetDir)', 'squad-tools'))</SquadToolsDir>
    </PropertyGroup>
    <RemoveDir Directories="$(SquadToolsDir)" />
    <Exec Command="dotnet publish &quot;$(SquadProject)&quot; --runtime $(NETCoreSdkPortableRuntimeIdentifier) --configuration $(Configuration) --property:PublishDir=&quot;$(SquadToolsDir)&quot; --nologo --verbosity quiet" />
    <Delete Files="$(CopilotProviderProjectDirectory)\obj\project.assets.json;$(CopilotProviderProjectDirectory)\obj\project.nuget.cache;$(CopilotProviderProjectDirectory)\obj\squad.AgentProvider.CopilotSdk.csproj.nuget.dgspec.json;$(CopilotProviderProjectDirectory)\obj\squad.AgentProvider.CopilotSdk.csproj.nuget.g.props;$(CopilotProviderProjectDirectory)\obj\squad.AgentProvider.CopilotSdk.csproj.nuget.g.targets" />
    <Exec Command="dotnet publish &quot;$(squadHQProject)&quot; --runtime $(NETCoreSdkPortableRuntimeIdentifier) --configuration $(Configuration) --property:PublishDir=&quot;$(SquadToolsDir)&quot; --nologo --verbosity quiet" />
  </Target>

  <!-- Stages one framework-dependent runtime from ordinary build outputs for backend specifications. Headquarters
       always requires a sibling "squad" helper executable, so both tools share this directory. The fake provider
       and stdio host remain outside it and are loaded by explicit descriptor from squad.Specs' own build output. -->
  <Target Name="StageBackendSpecTools" BeforeTargets="VSTest">
    <PropertyGroup>
      <BackendSpecToolsDir>$([System.IO.Path]::Combine('$(TargetDir)', 'squad-tools-backend-spec'))</BackendSpecToolsDir>
      <SquadBuildDir>$(MSBuildThisFileDirectory)..\squad\bin\$(Configuration)\$(TargetFramework)\</SquadBuildDir>
      <SquadHqBuildDir>$(MSBuildThisFileDirectory)..\squad-hq\bin\$(Configuration)\$(TargetFramework)\</SquadHqBuildDir>
    </PropertyGroup>
    <RemoveDir Directories="$(BackendSpecToolsDir)" />
    <ItemGroup>
      <BackendSpecToolFile Include="$(SquadHqBuildDir)*" />
      <BackendSpecToolFile Include="$(SquadBuildDir)*" />
    </ItemGroup>
    <Copy SourceFiles="@(BackendSpecToolFile)"
          DestinationFolder="$(BackendSpecToolsDir)" />
  </Target>

  <!-- Produces the combined provider-free and hosting-free package only for the packaging scenarios that request
       it. Ordinary backend specifications use StageBackendSpecTools instead. -->
  <Target Name="PublishNeutralSquadTools">
    <PropertyGroup>
      <NeutralSquadToolsDir>$([System.IO.Path]::Combine('$(TargetDir)', 'squad-tools-neutral'))</NeutralSquadToolsDir>
    </PropertyGroup>
    <RemoveDir Directories="$(NeutralSquadToolsDir)" />
    <Exec Command="dotnet publish &quot;$(SquadProject)&quot; --runtime $(NETCoreSdkPortableRuntimeIdentifier) --configuration $(Configuration) --property:PublishDir=&quot;$(NeutralSquadToolsDir)&quot; --nologo --verbosity quiet" />
    <Exec Command="dotnet publish &quot;$(squadHQProject)&quot; --runtime $(NETCoreSdkPortableRuntimeIdentifier) --configuration $(Configuration) --property:PublishDir=&quot;$(NeutralSquadToolsDir)&quot; --property:IncludeCopilotSdkProvider=false --property:IncludePhotinoHosting=false --nologo --verbosity quiet" />
  </Target>
  <!-- Publishes squad.Hosting.Stdio as its own standalone, framework-dependent artifact - complete with a real
       "squad.Hosting.Stdio.deps.json" and its own copies of every contract assembly it references
       (squad.Hosting.Abstractions, squad.Ui.Abstractions, squad.AgentProvider.Abstractions, squad.Ui.Protocol) -
       so the hosting-selection duplicate-contract-assembly scenario deploys a layout AssemblyDependencyResolver
       genuinely resolves. Without this real deps.json, PluginLoadContext could never actually resolve the local
       duplicate contract copies beside the plug-in, so a passing scenario would prove nothing about unification. -->
  <Target Name="PublishHostingStdioFixture">
    <PropertyGroup>
      <HostingStdioFixtureDir>$([System.IO.Path]::Combine('$(TargetDir)', 'hosting-fixture-duplicate-contracts'))</HostingStdioFixtureDir>
    </PropertyGroup>
    <RemoveDir Directories="$(HostingStdioFixtureDir)" />
    <Exec Command="dotnet publish &quot;$(HostingStdioProject)&quot; --runtime $(NETCoreSdkPortableRuntimeIdentifier) --configuration $(Configuration) --self-contained false --property:PublishDir=&quot;$(HostingStdioFixtureDir)&quot; --nologo --verbosity quiet" />
  </Target>

</Project>
