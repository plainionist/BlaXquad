<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ReqnrollDeleteObsoleteCodeBehindFilesOnClean>true</ReqnrollDeleteObsoleteCodeBehindFilesOnClean>
    <ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
    <SquadProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\squad\squad.csproj'))</SquadProject>
    <squadHQProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\squad-hq\squad-hq.csproj'))</squadHQProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.4" />
    <PackageReference Include="nunit" Version="4.5.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Reqnroll" />
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\squad.AgentProvider.Abstractions\squad.AgentProvider.Abstractions.csproj" />
  </ItemGroup>

  <Target Name="PublishSquadTools" BeforeTargets="VSTest">
    <PropertyGroup>
      <SquadToolsDir>$(TargetDir)squad-tools</SquadToolsDir>
    </PropertyGroup>
    <RemoveDir Directories="$(SquadToolsDir)" />
    <Exec Command="dotnet publish &quot;$(SquadProject)&quot; --runtime $(NETCoreSdkPortableRuntimeIdentifier) --configuration $(Configuration) --property:PublishDir=&quot;$(SquadToolsDir)&quot; --nologo --verbosity quiet" />
    <Exec Command="dotnet publish &quot;$(squadHQProject)&quot; --runtime $(NETCoreSdkPortableRuntimeIdentifier) --configuration $(Configuration) --property:PublishDir=&quot;$(SquadToolsDir)&quot; --nologo --verbosity quiet" />
  </Target>

  <!-- Publishes a second, provider-free squad-hq into its own test-output directory so backend
       specifications can prove the architectural target of running headquarters without ever
       loading squad.AgentProvider.CopilotSdk. The production-like squad-tools publication above stays unchanged.
       squad-hq always requires a sibling "squad" helper executable (WorkspacePreparer.CheckHelperScripts),
       so the CLI is published alongside it here too; squad.csproj has no squad.AgentProvider.CopilotSdk reference, so
       this does not reintroduce the Copilot provider into the provider-free output. -->
  <Target Name="PublishBackendSpecTools" BeforeTargets="VSTest">
    <PropertyGroup>
      <BackendSpecToolsDir>$(TargetDir)squad-tools-backend-spec</BackendSpecToolsDir>
    </PropertyGroup>
    <RemoveDir Directories="$(BackendSpecToolsDir)" />
    <Exec Command="dotnet publish &quot;$(SquadProject)&quot; --runtime $(NETCoreSdkPortableRuntimeIdentifier) --configuration $(Configuration) --property:PublishDir=&quot;$(BackendSpecToolsDir)&quot; --nologo --verbosity quiet" />
    <Exec Command="dotnet publish &quot;$(squadHQProject)&quot; --runtime $(NETCoreSdkPortableRuntimeIdentifier) --configuration $(Configuration) --property:PublishDir=&quot;$(BackendSpecToolsDir)&quot; --property:IncludeCopilotSdkProvider=false --nologo --verbosity quiet" />
  </Target>

</Project>
