    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\squad.Domain\squad.Domain.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
