  <PropertyGroup>
    <ApplicationIcon>Assets\BlaXquad.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Serilog is the concrete backend diagnostic-log implementation. It stays behind Microsoft.Extensions.Logging
         contracts everywhere else so squad-hq remains the only module tied to this particular logging framework. -->
