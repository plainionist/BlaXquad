<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Directory.Build.Tool.props" />
  <Import Project="..\squad.CopilotSdk\CopilotSdk.Publish.targets" />
  <Import Project="..\squad.Photino\Photino.Publish.targets" />

  <PropertyGroup>
    <ApplicationIcon>..\squad.Photino\Assets\BlaXquad.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="squad.Specs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\squad.AgentProvider.Abstractions\squad.AgentProvider.Abstractions.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\squad.Ui.Abstractions\squad.Ui.Abstractions.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\squad.Hosting.Abstractions\squad.Hosting.Abstractions.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\squad.Configuration\squad.Configuration.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\squad.Handoff\squad.Handoff.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\squad.Process\squad.Process.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\squad.CopilotSdk\squad.CopilotSdk.csproj"
              AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\squad.Photino\squad.Photino.csproj"
              AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\squad.Core\squad.Core.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\squad.Handoffs\squad.Handoffs.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
  </ItemGroup>

  <Target Name="BuildCopilotSdkRuntimeForPublish"
          BeforeTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != ''">
    <MSBuild Projects="..\squad.CopilotSdk\squad.CopilotSdk.csproj"
             Targets="Build"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);TargetFramework=$(TargetFramework)" />
  </Target>
</Project>
