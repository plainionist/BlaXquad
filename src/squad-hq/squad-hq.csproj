                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\squad.HeadquarterTools\squad.HeadquarterTools.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\squad.Hosting.Abstractions\squad.Hosting.Abstractions.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\squad.Configuration\squad.Configuration.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\squad.Process\squad.Process.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\squad.Application\squad.Application.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\squad.Handoffs\squad.Handoffs.csproj"
